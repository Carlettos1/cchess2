(
    schema_version: 1,
    id: "succubus", display_name: "Succubus", symbol: 'S',
    tags: [Demonic], base_stats: (transportable: Some(2)),
    action_rules: [
        (kind: Move, target: (origin: Source, pattern: InfiniteRay([NE,SE,SW,NW]), filters: [Empty], count: 1), effects: [MoveSource]),
        (kind: Take, target: (origin: Source, pattern: InfiniteRay([NE,SE,SW,NW]), filters: [Enemy,Occupied], count: 1), effects: [DamageTarget(1), MoveSourceIfTargetRemoved]),
    ],
    abilities: [(id: "deactivate", display_name: "Deactivate", target: (origin: Source, pattern: TaxicabRange(3), filters: [Enemy,Occupied,HasTag(Biological)], count: 1), cost: (actions: 1, mana: 1), cooldown: 2, effects: [AddStatus(kind: Deactivate, duration: 3)])],
    triggers: [(id: "demonic_mana", event: Removed, effects: [AddMana(1)])],
)
