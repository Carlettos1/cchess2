{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CChess",
  "version": "0.1.0",
  "identifier": "org.cchess.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "CChess · Arcane Table",
      "width": 1280,
      "height": 800,
      "minWidth": 760,
      "minHeight": 640,
      "resizable": true
    }],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": "all" }
}
